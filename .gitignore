artifacts/checkpoints/**/*.pt
artifacts/checkpoints/**/*.npz
artifacts/checkpoints/**/STOP
artifacts/experiments/

# logs
reports/logs/

# frontend
frontend/node_modules/
frontend/dist/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# local backups (contain confidential data)
backups/

# exported edge models (re-create with scripts/export_onnx.py)
artifacts/edge/

