# Copy to .env and adjust. All variables are optional in development.
QG_ENVIRONMENT=development
# QG_DATABASE_URL=postgresql+psycopg://qg:qg@localhost:5432/qualityguard   # default: SQLite in storage/
# QG_SCHEMA_MODE=migrations       # apply Alembic migrations at startup (recommended with PostgreSQL); default create_all
# QG_STORAGE_DIR=./storage
QG_SECRET_KEY=                       # REQUIRED in production (random 48+ chars); auto-generated in dev
QG_ACCESS_TOKEN_MINUTES=480
QG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QG_MAX_UPLOAD_MB=25
QG_MAX_VIDEO_MB=300
QG_MAX_BATCH_FILES=200
QG_WORKERS=2
QG_ALLOW_REGISTRATION=true           # self-registration creates Viewer accounts; they request inspect access from an admin
QG_DEFAULT_ADMIN_EMAIL=admin@qualityguard.local
QG_DEFAULT_ADMIN_PASSWORD=           # empty = random, written once to storage/INITIAL_CREDENTIALS.txt
QG_SEED_DEMO_USERS=true
QG_DATA_RETENTION_DAYS=0             # 0 = keep forever
QG_WEBHOOK_URL=                      # POSTs alert events as JSON
QG_ANTHROPIC_API_KEY=                # optional: enables LLM mode of the assistant
QG_ASSISTANT_MODEL=claude-opus-5-5
QG_TORCH_THREADS=0
